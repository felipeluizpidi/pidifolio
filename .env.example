# Senha do painel /admin (mínimo 12 caracteres)
ADMIN_PASSWORD=troque-esta-senha-longa
# Segredo para assinar o cookie de sessão (32+ caracteres aleatórios)
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# URL pública do site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pasta de armazenamento (conteúdo + uploads). Padrão: ./storage
# STORAGE_DIR=/var/data/felipe-pidi
